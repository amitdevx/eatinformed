# All Firebase values must belong to the SAME project on web and API.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only: choose one supported credential format. Never prefix these NEXT_PUBLIC_.
# JSON service account issued for the Firebase project:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or separate service-account fields:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or GOOGLE_APPLICATION_CREDENTIALS pointing to a server-only credential file.

APP_ORIGIN=https://eatinformed.amitdevx.tech
NVIDIA_API_KEY=
